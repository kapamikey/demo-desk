{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{fixtures/**,src/invoice/pdf.worker.mjs,api/pdf.worker.mjs,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
